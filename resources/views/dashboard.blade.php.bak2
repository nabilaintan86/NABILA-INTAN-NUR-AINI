                <a href="#" class="flex items-center px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-300">Detail Router</a>
                <a href="#" class="flex items-center px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-300">Log History</a>
                <a href="#" class="flex items-center px-4 py-2.5 rounded-lg hover:bg-gray-800 text-gray-300">Notifikasi</a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-y-auto">
            
            <!-- Topbar -->
            <header class="bg-white shadow-sm h-16 flex items-center justify-between px-8">
                <div class="text-gray-700 font-semibold">Dashboard &gt; Monitoring</div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm font-medium text-gray-700">Admin NOC</span>
                </div>
            </header>

            <!-- Content Area -->
            <main class="p-8 space-y-6">
                
                <!-- KPI CARDS (Dinamis dari Database) -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    
                    <!-- Devices UP -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
                        <div class="text-3xl font-bold text-gray-800">{{ $devices->where('status', 'up')->count() }}</div>
                        <div class="text-sm font-semibold text-green-600 mt-1">Devices UP</div>
                        <div class="text-xs text-gray-400 mt-2">Perangkat aktif berjalan normal</div>
                    </div>

                    <!-- Devices DOWN -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-red-500">
                        <div class="text-3xl font-bold text-gray-800">{{ $devices->where('status', 'down')->count() }}</div>
                        <div class="text-sm font-semibold text-red-600 mt-1">Devices DOWN</div>
                        <div class="text-xs text-gray-400 mt-2">Perlu tindakan segera</div>
                    </div>

                    <!-- Warning -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-yellow-500">
                        <div class="text-3xl font-bold text-gray-800">{{ $devices->where('status', 'warning')->count() }}</div>
                        <div class="text-sm font-semibold text-yellow-600 mt-1">Warning</div>
                        <div class="text-xs text-gray-400 mt-2">Latency / packet loss tinggi</div>
                    </div>

                    <!-- Total Monitored Device -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-blue-500">
                        <div class="text-3xl font-bold text-gray-800">{{ $devices->count() }}</div>
                        <div class="text-sm font-semibold text-blue-600 mt-1">Total Monitored Device</div>
                        <div class="text-xs text-gray-400 mt-2">Total perangkat terdaftar</div>
                    </div>

                </div>

                <!-- Tabel Daftar Perangkat dari Database -->
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Daftar Seluruh Perangkat Jaringan</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b text-gray-600 text-sm">
                                    <th class="py-3 px-4">Device Name</th>
                                    <th class="py-3 px-4">Hostname</th>
                                    <th class="py-3 px-4">Type</th>
                                    <th class="py-3 px-4">IP Address</th>
                                    <th class="py-3 px-4">Uptime</th>
                                    <th class="py-3 px-4">Avg Delay</th>
                                    <th class="py-3 px-4">Status</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm text-gray-700">
                                @forelse($devices as $device)
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="py-3 px-4 font-semibold">{{ $device->name }}</td>
                                    <td class="py-3 px-4 text-gray-500">{{ $device->hostname }}</td>
                                    <td class="py-3 px-4">{{ $device->type }}</td>
                                    <td class="py-3 px-4 font-mono">{{ $device->ip_address }}</td>
                                    <td class="py-3 px-4">{{ $device->uptime }}</td>
                                    <td class="py-3 px-4">{{ $device->avg_delay }} ms</td>
                                    <td class="py-3 px-4">
                                        @if($device->status == 'up')
                                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-bold uppercase">UP</span>
                                        @elseif($device->status == 'down')
                                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-bold uppercase">DOWN</span>
                                        @else
                                            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded text-xs font-bold uppercase">Warning</span>
                                        @endif
                                    </td>
                                </tr>
                                @empty
                                <tr>
                                    <td colspan="7" class="py-4 text-center text-gray-400">Belum ada data perangkat di database.</td>
                                </tr>
                                @endforelse
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

</body>
</html>