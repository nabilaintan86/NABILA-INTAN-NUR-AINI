@push('scripts')
<script>
(function () {
    'use strict';

    const csrf = document.querySelector('meta[name="csrf-token"]');

    /* SEARCH (server-side, auto-submit saat jeda ketik) */
    let ktSearchTimer = null;
    document.addEventListener('input', function (e) {
        const form = e.target.closest('form.kt-search');
        if (!form) return;
        clearTimeout(ktSearchTimer);
        ktSearchTimer = setTimeout(function () { form.submit(); }, 400);
    });

    /* DETAIL PERANGKAT (DIAGNOSTIK) */
    const routeDiagnose = '{{ route("admin.troubleshooting.diagnose") }}';
    const diagModal = new bootstrap.Modal(document.getElementById('diagModal'));

    function statusBadge(status) {
        const map = { up: 'ts-badge-up', down: 'ts-badge-down', warning: 'ts-badge-warning' };
        return '<span class="ts-badge ' + (map[status] || 'ts-badge-warning') + '"><span class="ts-dot"></span>' + status.toUpperCase() + '</span>';
    }

    function runDiag(deviceId, name, ip) {
        document.getElementById('diagLoading').style.display = 'block';
        document.getElementById('diagContent').style.display = 'none';
        document.getElementById('diagName').textContent = name;
        document.getElementById('diagIp').textContent = ip;
        document.getElementById('diagSummary').style.display = 'none';
        diagModal.show();

        const body = new FormData();
        body.append('device_id', deviceId);

        fetch(routeDiagnose, {
            method: 'POST',
            headers: { 'X-CSRF-TOKEN': csrf ? csrf.content : '' },
            body: body,
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            document.getElementById('diagLoading').style.display = 'none';
            document.getElementById('diagContent').style.display = 'block';

            if (!res.success) {
                document.getElementById('diagBadge').innerHTML = statusBadge('warning');
                document.getElementById('diagStatus').textContent = 'GAGAL';
                document.getElementById('diagOutput').textContent = res.message || 'Terjadi kesalahan menjalankan diagnostik.';
                return;
            }

            const log = res.log;
            document.getElementById('diagBadge').innerHTML = statusBadge(log.status);
            document.getElementById('diagStatus').textContent = log.status.toUpperCase();
            document.getElementById('diagLatency').innerHTML = (log.latency !== null && log.latency !== undefined)
                ? log.latency + ' ms' : '<span class="text-muted">—</span>';
            document.getElementById('diagMethod').textContent = log.diagnostic;
            document.getElementById('diagDuration').textContent = (Number(log.duration_ms) || 0) + ' ms';
            document.getElementById('diagTime').textContent = log.checked_at;
            document.getElementById('diagOutput').textContent =
                log.output || (log.error ? 'ERROR: ' + log.error : 'No output.');

            if (res.analysis && res.analysis.summary) {
                const s = document.getElementById('diagSummary');
                s.style.display = 'block';
                s.textContent = 'Kesimpulan: ' + res.analysis.summary;
            }
        })
        .catch(function () {
            document.getElementById('diagLoading').style.display = 'none';
            document.getElementById('diagContent').style.display = 'block';
            document.getElementById('diagOutput').textContent = 'Tidak dapat terhubung ke server. Coba lagi nanti.';
        });
    }

    /* KLIK BARIS → BUKA DETAIL PERANGKAT (sama seperti Troubleshooting) */
    document.addEventListener('click', function (e) {
        if (e.target.closest('button, a')) return;
        const row = e.target.closest('.js-row-detail');
        if (!row) return;
        runDiag(row.dataset.deviceId, row.dataset.name, row.dataset.ip);
    });
})();
</script>
@endpush