<script>
(function () {
    'use strict';

    const csrf = document.querySelector('meta[name="csrf-token"]');
    const routeDiagnose = '{{ route("admin.troubleshooting.diagnose") }}';
    const routeResolve  = '{{ route("admin.troubleshooting.resolve", ["id" => "__ID__"]) }}';

    const modal      = document.getElementById('detailModal');
    const modalBody  = modal.querySelector('.flex-1');

    const elName        = document.getElementById('dModalName');
    const elIp          = document.getElementById('dModalIp');
    const elType        = document.getElementById('dModalType');
    const elStatusBadge = document.getElementById('dModalStatusBadge');
    const elStatusVal   = document.getElementById('dModalStatusValue');
    const elLatency     = document.getElementById('dModalLatency');
    const elMethod      = document.getElementById('dModalMethod');
    const elDownTime    = document.getElementById('dModalDownTime');
    const elRawOutput   = document.getElementById('dModalRawOutput');
    const elAnalytics   = document.getElementById('dModalAnalytics');
    const elSummaryPanel= document.getElementById('dModalSummaryPanel');
    const elSummaryIcon = document.getElementById('dModalSummaryIcon');
    const elSummaryText = document.getElementById('dModalSummaryText');
    const elCausePanel  = document.getElementById('dModalCausePanel');
    const elCauseIcon   = document.getElementById('dModalCauseIcon');
    const elCauseBadge  = document.getElementById('dModalCauseBadge');
    const elCause       = document.getElementById('dModalCause');
    const elSteps       = document.getElementById('dModalSteps');
    const elRecovered   = document.getElementById('dModalRecovered');
    const elRecoveredMsg= document.getElementById('dModalRecoveredMsg');
    const btnResolve    = document.getElementById('dModalResolve');
    const btnRerun      = document.getElementById('dModalRerun');

    let currentId = null;
    let currentName = '';
    let currentIp = '';
    let currentStatus = null;

    /* ── PENCARIAN SERVER-SIDE (auto-submit saat jeda ketik) ── */
    let tsSearchTimer = null;
    document.addEventListener('input', function (e) {
        const form = e.target.closest('form.ts-search');
        if (!form) return;
        clearTimeout(tsSearchTimer);
        tsSearchTimer = setTimeout(function () { form.submit(); }, 400);
    });

    function escHTML(str) {
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    /* ── STATUS BADGE (Tailwind) ── */
    const badgeCls = {
        down:    'bg-red-50 text-red-700 border border-red-200',
        warning: 'bg-amber-50 text-amber-700 border border-amber-200',
        up:      'bg-emerald-50 text-emerald-700 border border-emerald-200',
    };
    const badgeStyle = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase';

    function statusBadge(status) {
        const cls = badgeCls[status] || badgeCls.warning;
        return '<span class="' + badgeStyle + ' ' + cls + '"><span class="inline-block w-2 h-2 rounded-full bg-current"></span>' +
               escHTML(String(status).toUpperCase()) + '</span>';
    }

    /* ── IKON & WARNA ANALISIS PER KATEGORI ── */
    const anaStyle = {
        offline: {
            panel: 'border-red-200 bg-red-50',
            icon:  'text-red-600',
            text:  'text-red-800',
            badge: 'bg-red-600 text-white',
            label: 'KRITIS',
        },
        latency: {
            panel: 'border-amber-200 bg-amber-50',
            icon:  'text-amber-600',
            text:  'text-amber-800',
            badge: 'bg-amber-500 text-white',
            label: 'PERINGATAN',
        },
        normal: {
            panel: 'border-emerald-200 bg-emerald-50',
            icon:  'text-emerald-600',
            text:  'text-emerald-800',
            badge: 'bg-emerald-600 text-white',
            label: 'NORMAL',
        },
    };

    function renderAnalysis(analysis) {
        if (!analysis || !analysis.summary) {
            elSummaryPanel.className = 'rounded-xl border border-blue-200 bg-blue-50 p-4';
            elSummaryIcon.className  = 'icon ni ni-briefcase text-blue-600';
            elSummaryText.className  = 'text-sm text-slate-700 leading-relaxed';
            elSummaryText.textContent = 'Tidak ada ringkasan analisis untuk perangkat ini.';
            elCausePanel.classList.add('hidden');
            return;
        }

        const style = anaStyle[analysis.category] || anaStyle.normal;
        const hasSteps = Array.isArray(analysis.steps) && analysis.steps.length > 0;

        elSummaryPanel.className = 'rounded-xl border p-4 ' + style.panel;
        elSummaryIcon.className  = 'icon ni ni-briefcase ' + style.icon;
        elSummaryText.className  = 'text-sm leading-relaxed ' + style.text;
        elSummaryText.textContent = analysis.summary;

        if (!hasSteps) {
            elCausePanel.classList.add('hidden');
            return;
        }

        elCausePanel.classList.remove('hidden');
        elCausePanel.className = 'mt-3 rounded-xl border p-4 ' + style.panel;
        elCauseIcon.className  = 'icon ni ni-zoom-in ' + style.icon;
        elCauseBadge.className = 'text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide ' + style.badge;
        elCauseBadge.textContent = style.label;
        elCause.textContent    = analysis.cause || '';
        elCause.className      = 'text-sm font-bold mb-0 ' + style.text;

        elSteps.innerHTML = '';
        analysis.steps.forEach(function (step, i) {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2 text-sm text-slate-700';
            const num = document.createElement('span');
            num.className = 'shrink-0 mt-0.5 w-5 h-5 rounded-full text-white text-[10px] font-bold flex items-center justify-center ' + style.badge;
            num.textContent = String(i + 1);
            const txt = document.createElement('span');
            txt.textContent = step;
            li.appendChild(num);
            li.appendChild(txt);
            elSteps.appendChild(li);
        });
    }

    function resetAnalysis() {
        elSummaryPanel.className = 'rounded-xl border border-blue-200 bg-blue-50 p-4';
        elSummaryIcon.className  = 'icon ni ni-briefcase text-blue-600';
        elSummaryText.className  = 'text-sm text-slate-700 leading-relaxed';
        elSummaryText.textContent = 'Menjalankan pemeriksaan…';
        elCausePanel.classList.add('hidden');
        elCause.innerHTML   = '—';
        elCauseBadge.textContent = '';
        elSteps.innerHTML   = '';
    }

    /* ── MODAL BUKA / TUTUP ── */
    function openModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    /* ── VISIBILITAS TOMBOL PULIHKAN (hanya DOWN/WARNING) ── */
    function setResolveVisible(status) {
        const show = status === 'down' || status === 'warning';
        btnResolve.classList.toggle('hidden', !show);
        if (show) {
            btnResolve.disabled = false;
            btnResolve.style.opacity = '1';
        }
    }

    /* ── EKSEKUSI DIAGNOSTIK ── */
    function runDiagnostic() {
        const body = new FormData();
        body.append('device_id', currentId);

        elRawOutput.textContent = '> Menjalankan diagnostik ICMP real-time pada ' + currentIp + '…\n> # ping -c 4 ' + currentIp;
        elAnalytics.classList.remove('hidden');
        elRecovered.classList.add('hidden');
        resetAnalysis();

        btnResolve.disabled = true;
        btnResolve.classList.add('hidden');
        btnRerun.disabled = true;
        btnRerun.style.opacity = '0.5';

        fetch(routeDiagnose, {
            method: 'POST',
            headers: { 'X-CSRF-TOKEN': csrf ? csrf.content : '' },
            body: body,
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (!res.success) {
                btnResolve.classList.add('hidden');
                btnRerun.disabled = false;
                btnRerun.style.opacity = '1';

                elStatusBadge.innerHTML = statusBadge('warning');
                elStatusVal.textContent = 'GAGAL';
                elLatency.textContent   = '—';
                elMethod.textContent    = '—';
                elRawOutput.textContent = '> ERROR: ' + (res.message || 'Terjadi kesalahan menjalankan diagnostik.');
                elSummaryText.textContent = res.message || 'Terjadi kesalahan menjalankan diagnostik.';
                elSummaryIcon.className  = 'icon ni ni-briefcase text-red-600';
                elCausePanel.classList.add('hidden');
                return;
            }

            const log = res.log;
            currentStatus = log.status;
            setResolveVisible(currentStatus);
            btnRerun.disabled = false;
            btnRerun.style.opacity = '1';

            elStatusBadge.innerHTML = statusBadge(log.status);
            elStatusVal.textContent = String(log.status).toUpperCase();
            elStatusVal.className   = 'mt-1 text-lg font-bold ' + (log.status === 'down' ? 'text-red-600' : log.status === 'warning' ? 'text-amber-600' : 'text-emerald-600');

            // Indikator latensi segaris dengan status perangkat.
            if (log.status === 'down') {
                elLatency.innerHTML = '<span class="text-slate-500 font-bold">-</span>';
            } else if (log.status === 'warning') {
                elLatency.innerHTML = Number(log.latency || 0) + ' <span class="text-xs font-normal text-amber-600">ms</span>';
            } else {
                elLatency.innerHTML = Number(log.latency || 0) + ' <span class="text-xs font-normal text-slate-400">ms</span>';
            }

            elMethod.textContent    = log.diagnostic;
            elRawOutput.textContent = log.output || (log.error ? '> ERROR: ' + log.error : '> Perintah selesai tanpa output.');

            if (res.device && res.device.down_time) {
                elDownTime.textContent = res.device.down_time;
            }

            renderAnalysis(res.analysis);
        })
        .catch(function () {
            btnResolve.classList.add('hidden');
            btnRerun.disabled = false;
            btnRerun.style.opacity = '1';
            elRawOutput.textContent = '> Tidak dapat terhubung ke server. Coba lagi nanti.';
            elStatusBadge.innerHTML = statusBadge('warning');
            elStatusVal.textContent = 'ERR';
            elSummaryText.textContent = 'Tidak dapat terhubung ke server. Coba lagi nanti.';
            elSummaryIcon.className  = 'icon ni ni-briefcase text-red-600';
            elCausePanel.classList.add('hidden');
        });
    }

    function openDetail(deviceId, name, ip, type, downTime, status) {
        currentId      = deviceId;
        currentName    = name;
        currentIp      = ip;
        currentStatus  = status || null;

        elName.textContent = name;
        elIp.textContent   = ip;
        elType.textContent = type || '—';
        elStatusVal.textContent = '…';
        elStatusVal.className   = 'mt-1 text-lg font-bold text-slate-800';
        elStatusBadge.innerHTML = '<span class="' + badgeStyle + ' bg-slate-100 text-slate-500 border border-slate-200">MENUNGGU</span>';
        elLatency.textContent   = '…';
        elMethod.textContent    = 'ICMP Ping (4 probe)';
        elDownTime.textContent  = downTime || '—';
        elRawOutput.textContent = '> Menyiapkan diagnostik…';
        elAnalytics.classList.remove('hidden');
        elRecovered.classList.add('hidden');
        resetAnalysis();
        setResolveVisible(currentStatus);

        openModal();
        runDiagnostic();
    }

    /* ── PULIHKAN STATUS ── */
    function resolveDevice() {
        if (!currentId || !confirm('Yakin ingin memulihkan status perangkat ini ke UP? (simulasi perbaikan)')) return;

        const url = routeResolve.replace('__ID__', String(currentId));
        btnResolve.disabled = true;
        btnResolve.innerHTML = '<span class="spinner-mini"></span> Menyimpan…';

        const body = new FormData();
        body.append('_method', 'POST');
        body.append('id', currentId);

        fetch(url, {
            method: 'POST',
            headers: { 'X-CSRF-TOKEN': csrf ? csrf.content : '' },
            body: body,
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            btnResolve.disabled = false;
            btnResolve.innerHTML = '<em class="icon ni ni-check-circle me-1"></em>Pulihkan Status (Set to UP)';
            if (!res.success) { alert(res.message || 'Gagal memulihkan status.'); return; }

            elStatusBadge.innerHTML = statusBadge('up');
            elStatusVal.textContent = 'UP';
            elStatusVal.className   = 'mt-1 text-lg font-bold text-emerald-600';
            elAnalytics.classList.add('hidden');
            elRecovered.classList.remove('hidden');
            elRecoveredMsg.textContent = res.message;
            setTimeout(function () { closeModal(); refreshTroubleshootingPage(); }, 1300);
        })
        .catch(function () {
            btnResolve.disabled = false;
            btnResolve.innerHTML = '<em class="icon ni ni-check-circle me-1"></em>Pulihkan Status (Set to UP)';
            alert('Tidak dapat terhubung ke server. Coba lagi nanti.');
        });
    }

    /* ── REFRESH & LOG ── */
    function refreshTroubleshootingPage() {
        const base = '{{ route("admin.troubleshooting") }}';
        const qs   = window.location.search;
        fetch(base + qs, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.text(); })
        .then(function (html) {
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const fresh = doc.querySelector('.nk-content-body');
            const target = document.querySelector('.nk-content-body');
            if (fresh && target) target.innerHTML = fresh.innerHTML;
        })
        .catch(function () {});
    }

    /* ── DELEGASI GLOBAL ── */
    document.addEventListener('click', function (e) {
        if (e.target.closest('[data-close]')) { closeModal(); return; }

        // Klik tombol Re-Test Connection
        const retest = e.target.closest('.js-diagnose');
        if (retest) {
            e.preventDefault();
            e.stopPropagation();
            const retestRow = retest.closest('.ts-row');
            openDetail(retest.dataset.deviceId, retest.dataset.name, retest.dataset.ip,
                       retestRow ? retestRow.dataset.type : retest.dataset.type,
                       retestRow ? retestRow.dataset.downTime : '',
                       retestRow ? retestRow.dataset.status : (retest.dataset.status || ''));
            return;
        }

        // Klik baris tabel -> buka modal detail
        const row = e.target.closest('.ts-row');
        if (row && row.querySelector('[data-close]') === null) {
            openDetail(row.dataset.deviceId, row.dataset.name, row.dataset.ip,
                       row.dataset.type, row.dataset.downTime, row.dataset.status || '');
            return;
        }

        if (e.target.closest('#dModalRerun')) { runDiagnostic(); return; }
        if (e.target.closest('#dModalResolve')) { resolveDevice(); return; }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
    });
})();
</script>
@endpush
