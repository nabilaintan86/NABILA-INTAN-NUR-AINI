<div id="detailModal" class="fixed inset-0 z-[1050] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" data-close></div>
    <div class="relative w-full max-w-3xl max-h-[92vh] overflow-hidden flex flex-col bg-white rounded-2xl shadow-2xl">
        {{-- Penutup --}}
        <button type="button" data-close
                class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition">
            <em class="icon ni ni-cross"></em>
        </button>

        {{-- Header modal --}}
        <div class="px-6 pt-6 pb-4 border-b border-slate-200">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center shrink-0 shadow-sm">
                    <em class="icon ni ni-signal" style="font-size:22px;"></em>
                </div>
                <div class="min-w-0">
                    <h3 class="text-lg font-bold text-slate-900 truncate" id="dModalName">—</h3>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span class="text-sm text-slate-500 font-mono" id="dModalIp">—</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600" id="dModalType">—</span>
                    </div>
                </div>
                <div class="ml-auto shrink-0">
                    <span id="dModalStatusBadge"></span>
                </div>
            </div>
        </div>

        {{-- Body modal --}}
        <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5">

            {{-- 1) RINGKASAN DATA (4 kotak, rapat & selalu terisi) --}}
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Status</div>
                    <div class="mt-1 text-base font-bold leading-tight" id="dModalStatusValue">—</div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Latensi</div>
                    <div class="mt-1 text-base font-bold text-slate-800 leading-tight" id="dModalLatency">—</div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Metode Tes</div>
                    <div class="mt-1 text-sm font-semibold text-slate-800 leading-snug" id="dModalMethod">—</div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Durasi</div>
                    <div class="mt-1 text-base font-bold text-slate-800 leading-tight" id="dModalDownTime">—</div>
                </div>
            </div>

            {{-- 2) RAW OUTPUT (TERMINAL NOC) --}}
            <div class="rounded-xl overflow-hidden border border-slate-700">
                <div class="flex items-center gap-2 px-4 py-2.5 bg-slate-900">
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#ff5f56;"></span>
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#ffbd2e;"></span>
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#27c93f;"></span>
                    <span class="ml-2 text-xs font-semibold text-slate-400">Raw Output — Terminal</span>
                    <span class="ml-auto text-[10px] font-bold tracking-wider text-green-400">LIVE</span>
                </div>
                <pre id="dModalRawOutput"
                     class="m-0 px-4 py-3 text-xs leading-[1.75] font-mono text-green-400 bg-slate-950 whitespace-pre-wrap break-words ts-terminal-body"
                     style="max-height:260px; min-height:120px; overflow-y:auto;">&gt; Menjalankan diagnostik…</pre>
            </div>

            {{-- 3) MANAJEMEN & ANALISIS (dinamis sesuai status perangkat) --}}
            <div id="dModalAnalytics">
                <div id="dModalSummaryPanel" class="rounded-xl border border-blue-200 bg-blue-50 p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <em id="dModalSummaryIcon" class="icon ni ni-briefcase text-blue-600"></em>
                        <h4 class="text-sm font-bold text-blue-900 uppercase tracking-wide">Ringkasan untuk Manajemen</h4>
                    </div>
                    <p id="dModalSummaryText" class="text-sm text-slate-700 leading-relaxed">Menjalankan pemeriksaan…</p>
                </div>

                <div id="dModalCausePanel" class="rounded-xl border border-red-200 bg-red-50 p-4 mt-3">
                    <div class="flex items-center gap-2 mb-2">
                        <em id="dModalCauseIcon" class="icon ni ni-zoom-in text-red-600"></em>
                        <h4 class="text-sm font-bold text-red-900 uppercase tracking-wide">Analisis Penyebab (Root Cause)</h4>
                    </div>
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                        <span id="dModalCauseBadge"
                              class="text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide"></span>
                        <p id="dModalCause" class="text-sm font-bold text-red-800 mb-0">—</p>
                    </div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Rekomendasi Langkah Teknis</div>
                    <ol id="dModalSteps" class="space-y-1.5"></ol>
                </div>
            </div>

            {{-- Recovery success --}}
            <div id="dModalRecovered" class="rounded-xl p-4 hidden bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">
                <em class="icon ni ni-check-circle me-2"></em><strong>Status dipulihkan ke UP.</strong>
                <span id="dModalRecoveredMsg"></span>
            </div>
        </div>

        {{-- Footer modal --}}
        <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-end gap-2">
            <button type="button" data-close
                    class="px-4 py-2 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition">
                Tutup
            </button>
            <button type="button" id="dModalResolve"
                    class="px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition">
                <em class="icon ni ni-check-circle me-1"></em>Pulihkan Status (Set to UP)
            </button>
            <button type="button" id="dModalRerun"
                    class="px-4 py-2 text-sm font-bold text-white rounded-lg transition"
                    style="background:linear-gradient(135deg,#dc2626,#f59e0b);">
                <em class="icon ni ni-reload me-1"></em>Jalankan Ulang
            </button>
        </div>
    </div>
</div>
@endsection

