<style>
    .ts-kpi .ts-kpi-icon {
        width: 52px; height: 52px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center; font-size: 22px;
    }
    .ts-kpi .ts-kpi-number { font-size: 26px; font-weight: 800; line-height: 1.1; }
    .ts-kpi .ts-kpi-label {
        font-size: 11.5px; color: #64748b; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
    }
    .kpi-blue  { background: #eff6ff; color: #2563eb; }
    .kpi-red   { background: #fee2e2; color: #dc2626; }
    .kpi-green { background: #dcfce7; color: #16a34a; }

    .ts-badge {
        font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px;
        display: inline-flex; align-items: center; gap: 5px;
    }
    .ts-badge .ts-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .ts-badge-down    { background: #fee2e2; color: #dc2626; }
    .ts-badge-warning { background: #fef9c3; color: #a16207; }
    .ts-badge-up      { background: #dcfce7; color: #15803d; }

    .filter-chip {
        font-size: 12.5px; font-weight: 600; padding: 7px 18px; border-radius: 999px;
        border: 1px solid #e2e8f0; background: #fff; color: #475569; cursor: pointer;
        transition: all .15s ease; display: inline-flex; align-items: center; gap: 6px;
        text-decoration: none;
    }
    .filter-chip:hover { border-color: #93c5fd; color: #2563eb; }
    .filter-chip.active {
        background: #2563eb; border-color: #2563eb; color: #fff;
        box-shadow: 0 4px 10px rgba(37, 99, 235, .25);
    }

    .ts-search { position: relative; flex: 1 1 280px; min-width: 230px; }
    .ts-search .icon {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        color: #94a3b8; font-size: 15px;
    }
    .ts-search input {
        padding-left: 34px; border-radius: 10px; border-color: #e2e8f0;
        font-size: 12.5px; box-shadow: none; height: 36px;
    }
    .ts-search input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, .12); }

    .pag-wrap {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 10px; padding-top: 12px; margin-top: 12px; border-top: 1px solid #eef2f7;
    }
    .pag-wrap .pag-info { font-size: 12px; color: #64748b; font-weight: 600; }
    .pag-wrap .pagination { margin: 0; }
    .pag-wrap .page-link {
        font-size: 12px; font-weight: 600; margin: 0 2px; border-radius: 8px;
        padding: .4rem .72rem;
    }

    .ts-table td, .ts-table th { vertical-align: middle; font-size: 12.5px; }
    .ts-table .device-name { font-weight: 700; color: #0f172a; }
    .ts-table .device-ip   { font-family: 'Consolas', monospace; font-size: 11.5px; color: #64748b; }
    .ts-table .ts-row { cursor: pointer; }
    .ts-table .ts-row:hover td { background: #f0f7ff; }

    .btn-retest {
        font-size: 12px; font-weight: 700; border-radius: 8px; color: #fff; border: 0;
        background: linear-gradient(135deg, #dc2626, #f59e0b);
        box-shadow: 0 4px 12px rgba(220, 38, 38, .25);
        padding: 8px 14px; display: inline-flex; align-items: center; gap: 6px;
        white-space: nowrap; transition: transform .15s ease, box-shadow .15s ease;
    }
    .btn-retest:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(220, 38, 38, .38); }

    .spinner-mini {
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%;
        display: inline-block; animation: ts-spin .7s linear infinite;
    }
    @keyframes ts-spin { to { transform: rotate(360deg); } }

    /* Terminal transparan untuk Raw Output */
    .ts-terminal-body::-webkit-scrollbar { width: 8px; }
    .ts-terminal-body::-webkit-scrollbar-thumb { background: #334155; border-radius: 8px; }
</style>
@endpush

