    Hanya Super Admin yang bisa CRUD device.
--}}


{{-- Icon URL map untuk JS --}}
<script>
window.WugIconMap = {
    @foreach(\App\Helpers\DeviceType::types() as $typeName)
        '{{ strtolower($typeName) }}': '{{ \App\Helpers\DeviceType::iconUrl($typeName) }}',
    @endforeach
};
window.WugIconFallback = '{{ \App\Helpers\DeviceType::iconUrl("Other") }}';
</script>

<style>
