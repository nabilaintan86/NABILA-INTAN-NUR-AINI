        box-shadow: 0 0 4px rgba(0,0,0,0.2);
    }
    .dvl-status-dot.up      { background: #22c55e; }
    .dvl-status-dot.down    { background: #ef4444; }
    .dvl-status-dot.warning { background: #f59e0b; }
    .dvl-info { flex: 1; min-width: 0; }
    .dvl-name {
        font-size: 12px;
        font-weight: 700;
        color: #1e293b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .dvl-meta {
        font-size: 10px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .dvl-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }
    .dvl-badge.map {
        background: #dcfce7;
        color: #166534;
    }
</style>

