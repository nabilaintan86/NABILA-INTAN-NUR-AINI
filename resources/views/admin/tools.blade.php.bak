    /* ── Ringkasan status hasil ping ──────────────────── */
    .ping-verdict {
        font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        border-radius: 10px;
        padding: 10px 14px;
        margin: 4px 0 10px;
