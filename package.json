{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "postbuild": "node -e \"const fs=require('fs');const p='public/build/manifest.json';if(fs.existsSync(p)){const m=JSON.parse(fs.readFileSync(p,'utf8'));const e=m['resources/css/ping-monitor.css'];if(e&&e.file){fs.mkdirSync('public/css',{recursive:true});fs.copyFileSync('public/build/'+e.file,'public/css/ping-monitor.css');console.log('Fallback CSS disalin: public/css/ping-monitor.css');}}\"",
        "dev": "vite --host 0.0.0.0 --port 5173",
        "preview": "vite preview --host 0.0.0.0 --port 4173"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
